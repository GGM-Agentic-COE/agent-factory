    },
    "mapping_rule": "Four ADLC levels, three Jira levels. The collapsible-story rule resolves the collision: an unsliced feature becomes the Story itself; a sliced feature contributes no issue of its own and its slices become the Stories, with the feature carried as a label and through the Epic link. Exactly one of Feature or Slice occupies the Story level on any branch, so no issue is ever both.",
    "field_mapping": {
      "unit_points": "customfield_10016 (Story Points)",
      "layer": "labels (layer:<value>)",
      "feature_id": "labels (feature:<value>)",
      "verification_ref": "customfield_10412 (Verification Ref), comma-separated",
      "acceptance_criteria": "description (Given/When/Then block)",
      "depends_on_unit": "issue link type 'Blocks' / 'is blocked by'",
      "workflow_execution_id": "customfield_10500 (ADLC Run Id)"
    },
    "idempotency": {
      "strategy": "fetch-before-create on the ADLC id held in customfield_10501 (ADLC Id)",
      "note": "Epics are human-authored and were created in a prior PI-planning run. Re-creating them would fork the hierarchy silently, which is why every level is fetched first and created only on a miss."
    },
    "do_not_push": [
      "rightsizing_log — evaluator material, not delivery state",
      "capacity_signal disposition — cycle and disposition are the feature-cycle-planner's fields; writing 'overflow' into Jira before the planner has decided would make Jira disagree with cycle-plan.md"
    ]
